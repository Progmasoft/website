import SiteLayout from "../layouts/SiteLayout.astro";

const pipeline = [
  { short: "XS", label: "Source", detail: "syntax + AST" },
  { short: "HI", label: "XHIR", detail: "typed intent" },
  { short: "MI", label: "XMIR", detail: "control flow" },
  { short: "LI", label: "XLIL", detail: "register IL" },
  { short: "EX", label: ".xse", detail: "native output" },
];

const principles = [
  {
    number: "01",
    title: "Inspect every layer",
    text: "XHIR, XMIR, and XLIL are versioned text formats designed for people, tools, and other languages.",
    icon: "layers",
  },
  {
    number: "02",
    title: "Keep the core modular",
    text: "The C23 frontend and Rust compiler core meet through narrow boundaries instead of sharing backend state.",
    icon: "modules",
  },
  {
    number: "03",
    title: "Finish in native code",
    text: "Verified XLIL lowers through LLVM IR to object code and a platform-native .xse executable.",
    icon: "native",
  },
];
---

<SiteLayout
  title="X# programming language"
  description="The official home of X#, a native programming language with inspectable compiler layers."
>
  <div class="ambient" aria-hidden="true">
    <span class="ambient-orb ambient-orb-a"></span>
    <span class="ambient-orb ambient-orb-b"></span>
    <span class="ambient-orb ambient-orb-c"></span>
    <span class="noise"></span>
  </div>

  <header class="site-header glass-panel">
    <a class="brand" href="/" aria-label="X# home">
      <img class="brand-mark" src="/xsharp-logo.webp" width="38" height="38" alt="" />
      <span class="brand-name">X#</span>
      <span class="brand-channel">language</span>
    </a>
    <nav aria-label="Primary navigation">
      <a href="#pipeline">Pipeline</a>
      <a href="https://github.com/xss-lang/xs-project/tree/main/Spec" target="_blank" rel="noreferrer">Specification</a>
      <a class="nav-source" href="https://github.com/xss-lang/xs-project" target="_blank" rel="noreferrer">
        GitHub
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4m-6 0h6v6" /></svg>
      </a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <div class="hero-copy">
        <div class="status-pill glass-panel">
          <span class="status-light"></span>
          Native compiler in active development
        </div>
        <h1>See the language <em>all the way down.</em></h1>
        <p class="lede">
          X# is a native programming language built around explicit compiler stages, readable intermediate formats,
          and a direct path from source to platform executable.
        </p>
        <div class="actions">
          <a class="button primary" href="https://github.com/xss-lang/xs-project" target="_blank" rel="noreferrer">
            Explore the compiler
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7 4 6 6-6 6" /></svg>
          </a>
          <a class="button secondary glass-panel" href="https://github.com/xss-lang/xs-project/tree/main/Spec/Programs" target="_blank" rel="noreferrer">
            View examples
          </a>
        </div>
        <div class="hero-facts" aria-label="Project facts">
          <div><strong>0</strong><span>IR format version</span></div>
          <div><strong>C23 + Rust</strong><span>compiler foundation</span></div>
          <div><strong>.xse</strong><span>native artifact</span></div>
        </div>
      </div>

      <div class="hero-visual" aria-label="Animated X# compiler pipeline visualization">
        <div class="visual-glow"></div>
        <div class="orbit orbit-wide" aria-hidden="true"></div>
        <div class="orbit orbit-tight" aria-hidden="true"></div>
        <div class="orbit-dot orbit-dot-a" aria-hidden="true"></div>
        <div class="orbit-dot orbit-dot-b" aria-hidden="true"></div>

        <div class="compiler-core glass-panel">
          <span class="core-scan" aria-hidden="true"></span>
          <img src="/xsharp-logo.webp" width="132" height="132" alt="X#" />
          <span>compiler core</span>
        </div>

        <div class="floating-node node-source glass-panel">
          <span class="node-icon">&#123; &#125;</span>
          <span><strong>source.xs</strong><small>parsed</small></span>
        </div>
        <div class="floating-node node-ir glass-panel">
          <span class="node-icon">%r</span>
          <span><strong>XLIL v0</strong><small>verified</small></span>
        </div>
        <div class="floating-node node-native glass-panel">
          <span class="node-icon">▶</span>
          <span><strong>native.xse</strong><small>linked</small></span>
        </div>

        <div class="build-console glass-panel">
          <div class="console-bar">
            <span></span><span></span><span></span>
            <strong>xs build</strong>
          </div>
          <div class="console-body">
            <p><span>01</span><code>parse</code><i>done</i></p>
            <p><span>02</span><code>lower → xlil</code><i>done</i></p>
            <p><span>03</span><code>link → app.xse</code><i class="pulse-text">ready</i></p>
          </div>
        </div>
      </div>
    </section>

    <section id="pipeline" class="pipeline-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">A visible compiler</p>
          <h2>One language.<br />Every transformation.</h2>
        </div>
        <p>
          Each boundary has a defined responsibility. Higher layers never borrow LLVM semantics, and lower layers never
          invent source-language behavior.
        </p>
      </div>

      <div class="pipeline-track glass-panel">
        <div class="track-line" aria-hidden="true"><span></span></div>
        {pipeline.map((stage, index) => (
          <article class="pipeline-stage">
            <div class="stage-glyph"><span>{stage.short}</span></div>
            <small>{String(index + 1).padStart(2, "0")}</small>
            <h3>{stage.label}</h3>
            <p>{stage.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="showcase">
      <div class="code-window glass-panel">
        <div class="window-top">
          <div><span></span><span></span><span></span></div>
          <p>Sources/main.xs</p>
          <span class="window-badge">X#</span>
        </div>
        <pre><code>{`fn add(a: Long, b: Long) -> Long {
    a + b
}

fn main() -> Long {
    answer := add(20, 22);
    answer
}`}</code></pre>
        <div class="code-shine" aria-hidden="true"></div>
      </div>

      <div class="showcase-copy">
        <p class="eyebrow">Readable at both ends</p>
        <h2>Expressive source.<br />Predictable output.</h2>
        <p>
          Tail expressions, nominal types, explicit module boundaries, and native artifacts belong to one coherent
          pipeline—not a collection of disconnected tools.
        </p>
        <a class="text-link" href="https://github.com/xss-lang/xs-project/tree/main/Spec/Programs" target="_blank" rel="noreferrer">
          Browse complete programs <span>→</span>
        </a>
      </div>
    </section>

    <section class="principles" aria-labelledby="principles-title">
      <div class="section-heading compact">
        <div>
          <p class="eyebrow">Compiler principles</p>
          <h2 id="principles-title">Built with boundaries.</h2>
        </div>
      </div>
      <div class="cards">
        {principles.map((item) => (
          <article class="principle-card glass-panel">
            <div class={`principle-icon ${item.icon}`} aria-hidden="true"><span></span><i></i><b></b></div>
            <span class="card-number">{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="closing glass-panel">
      <div class="closing-orb" aria-hidden="true"></div>
      <div>
        <p class="eyebrow">Follow the implementation</p>
        <h2>The compiler is open.</h2>
        <p>Read the source, inspect the formats, and watch each native milestone land.</p>
      </div>
      <a class="button primary" href="https://github.com/xss-lang/xs-project" target="_blank" rel="noreferrer">Open repository</a>
    </section>
  </main>

  <footer>
    <a class="footer-brand" href="/"><img src="/xsharp-logo.webp" width="32" height="32" alt="" /> X#</a>
    <span>Native language · visible compiler</span>
    <a href="https://github.com/xss-lang/website" target="_blank" rel="noreferrer">Website source · AGPL-3.0-or-later</a>
  </footer>
</SiteLayout>
