import SiteLayout from "../layouts/SiteLayout.astro";
import Icon from "../components/Icon.astro";

const pipeline = [
  { short: "VX", label: "Source", detail: ".vxs input" },
  { short: "AST", label: "Typed AST", detail: "resolved meaning" },
  { short: "CO", label: "Core", detail: "language semantics" },
  { short: "XP", label: "Xpp", detail: "prepared program" },
  { short: "XM", label: "Xmm", detail: "backend-ready IR" },
];

const principles = [
  {
    number: "01",
    title: "Keep every boundary explicit",
    text: "Parsed, resolved, and typed syntax stay distinct before semantics move through Core, Xpp, and Xmm.",
    icon: "layers",
  },
  {
    number: "02",
    title: "Keep the core modular",
    text: "Haskell owns the language front end while the C++20 native pipeline begins at the CorePrep boundary.",
    icon: "modules",
  },
  {
    number: "03",
    title: "Finish in native code",
    text: "Verified Xmm lowers through LLVM to object code and a platform-native .vxse executable.",
    icon: "native",
  },
] as const;

const capabilities = [
  { icon: "braces", label: "Structural AST", detail: "source fidelity" },
  { icon: "layers", label: "Typed AST", detail: "resolved semantics" },
  { icon: "modules", label: "Core pipeline", detail: "explicit boundaries" },
  { icon: "registers", label: "Xmm verifier", detail: "backend contract" },
  { icon: "chip", label: "LLVM backend", detail: "native codegen" },
  { icon: "terminal", label: "Test runner", detail: "isolated .vxse" },
] as const;
---

<SiteLayout
  title="Visual X# programming language"
  description="The official home of Visual X#, a native programming language with inspectable compiler layers."
>
  <div class="ambient" aria-hidden="true">
    <span class="ambient-orb ambient-orb-a"></span>
    <span class="ambient-orb ambient-orb-b"></span>
    <span class="ambient-orb ambient-orb-c"></span>
    <span class="noise"></span>
  </div>

  <header class="site-header glass-panel">
    <a class="brand" href="/" aria-label="Visual X# home">
      <img class="brand-mark" src="/xsharp-logo.webp" width="38" height="38" alt="" />
      <span class="brand-name">Visual X#</span>
      <span class="brand-channel">language</span>
    </a>
    <nav aria-label="Primary navigation">
      <a href="#pipeline">Pipeline</a>
      <a href="https://viget.xsharp-lang.xyz/">Packages</a>
      <a href="https://github.com/Progmasoft/visual-xsharp/tree/main/Spec" target="_blank" rel="noreferrer">Specification</a>
      <a class="nav-source" href="https://github.com/Progmasoft/visual-xsharp" target="_blank" rel="noreferrer">
        <Icon name="github" />
        <span>GitHub</span>
      </a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <div class="hero-copy">
        <div class="status-pill glass-panel">
          <span class="status-light"></span>
          Visual X# · Native compiler in active development
        </div>
        <h1>See the language <em>all the way down.</em></h1>
        <p class="lede">
          Visual X# is a native programming language built around explicit compiler stages, inspectable boundaries,
          and a direct path from source to platform executable.
        </p>
        <div class="actions">
          <a class="button primary" href="https://github.com/Progmasoft/visual-xsharp" target="_blank" rel="noreferrer">
            Explore the compiler
            <Icon name="arrow" />
          </a>
          <a class="button secondary glass-panel" href="https://github.com/Progmasoft/visual-xsharp/tree/main/Spec" target="_blank" rel="noreferrer">
            View examples
          </a>
        </div>
        <div class="hero-facts" aria-label="Project facts">
          <div><strong>3</strong><span>semantic IR layers</span></div>
          <div><strong>Haskell + C++20</strong><span>compiler foundation</span></div>
          <div><strong>.vxse</strong><span>native artifact</span></div>
        </div>
      </div>

      <div class="hero-visual" aria-label="Animated Visual X# compiler pipeline visualization">
        <div class="visual-glow"></div>
        <div class="orbit orbit-wide" aria-hidden="true"></div>
        <div class="orbit orbit-tight" aria-hidden="true"></div>
        <div class="orbit-dot orbit-dot-a" aria-hidden="true"></div>
        <div class="orbit-dot orbit-dot-b" aria-hidden="true"></div>

        <div class="compiler-core glass-panel">
          <span class="core-scan" aria-hidden="true"></span>
          <img src="/xsharp-logo.webp" width="132" height="132" alt="Visual X#" />
          <span>compiler core</span>
        </div>

        <div class="floating-node node-source glass-panel">
          <span class="node-icon"><Icon name="braces" /></span>
          <span><strong>source.vxs</strong><small>parsed</small></span>
        </div>
        <div class="floating-node node-ir glass-panel">
          <span class="node-icon"><Icon name="registers" /></span>
          <span><strong>Xmm</strong><small>verified</small></span>
        </div>
        <div class="floating-node node-native glass-panel">
          <span class="node-icon"><Icon name="native" /></span>
          <span><strong>native.vxse</strong><small>linked</small></span>
        </div>

        <div class="build-console glass-panel">
          <div class="console-bar">
            <span></span><span></span><span></span>
            <strong>vxs build</strong>
          </div>
          <div class="console-body">
            <p><span>01</span><code>parse</code><i>done</i></p>
            <p><span>02</span><code>lower → core → xpp → xmm</code><i>done</i></p>
            <p><span>03</span><code>link → app.vxse</code><i class="pulse-text">ready</i></p>
          </div>
        </div>
      </div>
    </section>

    <section class="capabilities-section" aria-labelledby="capabilities-title">
      <div class="capabilities-copy">
        <p class="eyebrow">One compiler, visible end to end</p>
        <h2 id="capabilities-title">Everything needed to understand the build.</h2>
        <p>
          Visual X# keeps the useful machinery in the open. Inspect typed decisions, follow control flow, and retain a clear
          record before native code is emitted.
        </p>
        <a class="text-link" href="https://github.com/Progmasoft/visual-xsharp/blob/main/docs/ARCHITECTURE.md" target="_blank" rel="noreferrer">
          Read the architecture <span>→</span>
        </a>
      </div>
      <div class="capability-grid">
        {capabilities.map((item, index) => (
          <article class="capability-tile glass-panel">
            <span class="capability-icon"><Icon name={item.icon} /></span>
            <div>
              <h3>{item.label}</h3>
              <p>{item.detail}</p>
            </div>
            <small>{String(index + 1).padStart(2, "0")}</small>
          </article>
        ))}
      </div>
    </section>

    <section id="pipeline" class="pipeline-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">A visible compiler</p>
          <h2>One language.<br />Every transformation.</h2>
        </div>
        <p>
          Each boundary has a defined responsibility. Higher layers never borrow LLVM semantics, and lower layers never
          invent source-language behavior.
        </p>
      </div>

      <div class="pipeline-track glass-panel">
        <div class="track-line" aria-hidden="true"><span></span></div>
        {pipeline.map((stage, index) => (
          <article class="pipeline-stage">
            <div class="stage-glyph"><span>{stage.short}</span></div>
            <small>{String(index + 1).padStart(2, "0")}</small>
            <h3>{stage.label}</h3>
            <p>{stage.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="showcase">
      <div class="code-window glass-panel">
        <div class="window-top">
          <div><span></span><span></span><span></span></div>
          <p>Sources/main.vxs</p>
          <span class="window-badge">Visual X#</span>
        </div>
        <pre><code>{`int Sum(_ int left, _ int right) {
    left + right
}

auto Factorial(_ int value) {
    if (value <= 1) {
        return 1;
    }

    value * Factorial(value - 1)
}`}</code></pre>
        <div class="code-shine" aria-hidden="true"></div>
      </div>

      <div class="showcase-copy">
        <p class="eyebrow">Readable at both ends</p>
        <h2>Expressive source.<br />Predictable output.</h2>
        <p>
          Tail expressions, nominal types, explicit module boundaries, and native artifacts belong to one coherent
          pipeline—not a collection of disconnected tools.
        </p>
        <a class="text-link" href="https://github.com/Progmasoft/visual-xsharp/tree/main/Spec" target="_blank" rel="noreferrer">
          Browse complete programs <span>→</span>
        </a>
      </div>
    </section>

    <section class="principles" aria-labelledby="principles-title">
      <div class="section-heading compact">
        <div>
          <p class="eyebrow">Compiler principles</p>
          <h2 id="principles-title">Built with boundaries.</h2>
        </div>
      </div>
      <div class="cards">
        {principles.map((item) => (
          <article class="principle-card glass-panel">
            <div class={`principle-icon ${item.icon}`}>
              <Icon name={item.icon} />
            </div>
            <span class="card-number">{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="closing glass-panel">
      <div class="closing-orb" aria-hidden="true"></div>
      <div>
        <p class="eyebrow">Follow the implementation</p>
        <h2>The compiler is open.</h2>
        <p>Read the source, inspect the formats, and watch each native milestone land.</p>
      </div>
      <a class="button primary" href="https://github.com/Progmasoft/visual-xsharp" target="_blank" rel="noreferrer">Open repository</a>
    </section>
  </main>

  <footer>
    <a class="footer-brand" href="/"><img src="/xsharp-logo.webp" width="32" height="32" alt="" /> Visual X#</a>
    <span>Native language · visible compiler</span>
    <a href="https://github.com/Progmasoft/website" target="_blank" rel="noreferrer">Website source · AGPL-3.0-or-later</a>
  </footer>
</SiteLayout>
