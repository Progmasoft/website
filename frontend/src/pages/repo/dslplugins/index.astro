import RepositoryFooter from "../../../components/RepositoryFooter.astro";
import RepositoryHeader from "../../../components/RepositoryHeader.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
---

<SiteLayout
  title="DSL Plugins · ViGet Package Registry by Progmasoft"
  description="The ViGet Kotlin DSL plugin catalog is online, but no plugins have been published yet."
  theme="progmasoft"
>
  <section class="registry-surface">
    <RepositoryHeader />
    <main>
      <section class="registry-subhero">
        <div class="registry-shell registry-subhero-grid">
          <div>
            <p class="registry-eyebrow">ViGet · Kotlin DSL plugins</p>
            <h1>Extend the project model.</h1>
            <p>Kotlin DSL plugins are JAR artifacts for Visual.XSharp.kts. They are separate from Visual X# .vipkg packages.</p>
            <div class="registry-actions">
              <a class="registry-button registry-button-secondary" href="https://viget.progmasoft.com/">Back to packages</a>
              <a class="registry-text-link" href="https://github.com/Progmasoft/visual-xsharp">Follow development →</a>
            </div>
          </div>
          <aside class="registry-availability" aria-labelledby="plugin-availability-title">
            <div class="registry-availability-heading">
              <span class="registry-status-dot" aria-hidden="true"></span>
              <span>Catalog available</span>
            </div>
            <h2 id="plugin-availability-title">No public DSL plugins yet.</h2>
            <p>The catalog is ready and intentionally contains no placeholder artifacts.</p>
            <code class="registry-coordinate">/dslplugins/&lt;Publisher&gt;/&lt;Name&gt;/</code>
          </aside>
        </div>
      </section>
      <section class="registry-guidance">
        <div class="registry-shell registry-guidance-grid">
          <div><span>Format</span><strong>Kotlin JAR</strong><p>DSL plugins run as Kotlin/JVM project extensions.</p></div>
          <div><span>Location</span><strong>Dedicated catalog</strong><p>Plugin coordinates always begin with /dslplugins.</p></div>
          <div><span>Availability</span><strong>Publishing closed</strong><p>Publishing opens only after the signed plugin contract is complete.</p></div>
        </div>
      </section>
    </main>
    <RepositoryFooter />
  </section>
</SiteLayout>
