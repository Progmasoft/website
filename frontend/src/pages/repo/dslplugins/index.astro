import Icon from "../../../components/Icon.astro";
import RepositoryHeader from "../../../components/RepositoryHeader.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
---

<SiteLayout
  title="DSL Plugins · ViGet Package Registry by Progmasoft"
  description="The ViGet Kotlin DSL plugin catalog is online, but no plugins have been published yet."
>
  <section class="repository-surface">
    <div class="ambient" aria-hidden="true">
      <span class="ambient-orb ambient-orb-a"></span>
      <span class="ambient-orb ambient-orb-b"></span>
    </div>
    <RepositoryHeader />
    <main class="repository-main">
      <div class="repository-status glass-panel">
        <span class="repository-status-icon"><Icon name="modules" /></span>
        DSL plugin catalog online
      </div>
      <p class="eyebrow">Kotlin DSL plugins</p>
      <h1>No DSL plugins<br /><em>published yet.</em></h1>
      <p class="repository-lede">
        Kotlin DSL plugins are distributed as JAR artifacts under
        <code>/dslplugins/&lt;Publisher&gt;/&lt;Name&gt;/</code>. The catalog is ready, but it does not contain any public
        plugin releases yet.
      </p>
      <div class="repository-actions">
        <a class="button primary" href="https://viget.progmasoft.com/">
          Browse Visual X# packages
          <Icon name="arrow" />
        </a>
        <a class="button secondary glass-panel" href="https://github.com/Progmasoft/visual-xsharp" target="_blank" rel="noreferrer">
          Follow development
        </a>
      </div>
      <div class="repository-note glass-panel">
        <Icon name="terminal" />
        <div>
          <strong>Publishing is not available yet</strong>
          <span>No placeholder artifacts or package identities are shown before real plugins are published.</span>
        </div>
      </div>
    </main>
    <footer class="repository-footer">
      <span>viget.progmasoft.com/dslplugins</span>
      <span>Kotlin DSL plugin catalog</span>
    </footer>
  </section>
</SiteLayout>
