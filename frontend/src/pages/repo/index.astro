import Icon from "../../components/Icon.astro";
import RepositoryHeader from "../../components/RepositoryHeader.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Visual X# Package Registry"
  description="The Visual X# package registry is online, but no packages have been published yet."
>
  <section class="repository-surface">
    <div class="ambient" aria-hidden="true">
      <span class="ambient-orb ambient-orb-a"></span>
      <span class="ambient-orb ambient-orb-b"></span>
    </div>
    <RepositoryHeader />
    <main class="repository-main">
      <div class="repository-status glass-panel">
        <span class="repository-status-icon"><Icon name="modules" /></span>
        Registry online
      </div>
      <p class="eyebrow">Visual X# package registry</p>
      <h1>No packages<br /><em>published yet.</em></h1>
      <p class="repository-lede">
        The registry is ready for the next stage of Visual X# development, but it does not contain any
        public package releases yet.
      </p>
      <div class="repository-actions">
        <a class="button primary" href="https://xsharp-lang.xyz/">
          Visit Visual X# language
          <Icon name="arrow" />
        </a>
        <a class="button secondary glass-panel" href="https://github.com/Progmasoft/visual-xsharp" target="_blank" rel="noreferrer">
          Follow development
        </a>
      </div>
      <div class="repository-note glass-panel">
        <Icon name="terminal" />
        <div>
          <strong>Publishing is not available yet</strong>
          <span>The future registry will use the native Visual X# package format and verified package metadata.</span>
        </div>
      </div>
    </main>
    <footer class="repository-footer">
      <span>viget.xsharp-lang.xyz</span>
      <span>Package registry preview</span>
    </footer>
  </section>
</SiteLayout>
