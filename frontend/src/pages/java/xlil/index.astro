import { marked } from "marked";
import Icon from "../../../components/Icon.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import xlilReadme from "../../../content/java/xlil.md?raw";

const renderedReadme = await marked.parse(xlilReadme);
---

<SiteLayout
  title="XLIL for Java · X# Java Repository"
  description="Java 25 FFM reader and writer bindings for the stable XLIL C ABI."
>
  <section class="repository-surface">
    <div class="ambient" aria-hidden="true">
      <span class="ambient-orb ambient-orb-a"></span>
      <span class="ambient-orb ambient-orb-b"></span>
    </div>
    <header class="repository-header glass-panel">
      <a class="brand" href="../" aria-label="X# Java repository">
        <img class="brand-mark" src="/xsharp-logo.webp" width="38" height="38" alt="" />
        <span class="brand-name">X#</span>
        <span class="brand-channel">Java repository</span>
      </a>
      <a class="repository-source" href="../" aria-label="Back to packages">
        <Icon name="modules" />
        Packages
      </a>
    </header>

    <main class="repository-main package-detail">
      <header class="package-detail-header">
        <span class="package-icon package-icon-large"><Icon name="registers" /></span>
        <div>
          <p class="eyebrow">org.xsslang:xlil</p>
          <h1>XLIL</h1>
          <p>Java 25 · FFM · XLIL v1 · package 2026.1</p>
        </div>
      </header>

      <div class="package-detail-grid">
        <article class="markdown-body glass-panel" set:html={renderedReadme}></article>
        <aside class="package-sidebar">
          <section class="glass-panel">
            <p class="eyebrow">Latest release</p>
            <strong>2026.1</strong>
            <span>Java 25 or newer</span>
          </section>
          <section class="glass-panel">
            <p class="eyebrow">Artifacts</p>
            <a href="/org/xsslang/xlil/2026.1/xlil-2026.1.jar">JAR</a>
            <a href="/org/xsslang/xlil/2026.1/xlil-2026.1-sources.jar">Sources</a>
            <a href="/org/xsslang/xlil/2026.1/xlil-2026.1-javadoc.jar">Javadoc</a>
            <a href="/org/xsslang/xlil/2026.1/xlil-2026.1.pom">POM</a>
          </section>
          <section class="glass-panel package-read-only">
            <Icon name="check" />
            <div>
              <strong>Read-only</strong>
              <span>User uploads are disabled.</span>
            </div>
          </section>
        </aside>
      </div>
    </main>

    <footer class="repository-footer">
      <span>java.xsharp-lang.xyz/xlil</span>
      <span>Rendered from package Markdown</span>
    </footer>
  </section>
</SiteLayout>
