{
  "metadata": [
    {
      "src": [
        {
          "src": "../../backend/Progmasoft.Tala.Website.Api",
          "files": [
            "Progmasoft.Tala.Website.Api.csproj"
          ]
        }
      ],
      "dest": "reference",
      "includePrivateMembers": true
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml",
          "reference/**/*.yml"
        ]
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_appTitle": "Tala website API",
      "_enableSearch": false
    },
    "overwrite": [
      {
        "files": [
          "namespaces/*.md"
        ]
      }
    ]
  }
}
