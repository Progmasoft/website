<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Progmasoft.Tala.Website.Api</RootNamespace>
    <AssemblyName>Progmasoft.Tala.Website.Api</AssemblyName>
    <Version>2.0.0</Version>
    <!-- A public declaration without its documentation comment fails the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The service is a single small process; the server already provides the shared runtime. -->
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Progmasoft.Tala.Website.Api.Tests" />
  </ItemGroup>
</Project>
